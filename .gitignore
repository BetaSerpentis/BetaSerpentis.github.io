# 依赖目录
node_modules/

# 日志文件
*.log
logs/

# 环境变量文件（通常包含敏感信息）
.env

# 运行时文件
*.pid

# 构建输出目录
dist/
build/

# IDE 配置文件（如果你使用特定编辑器，如 VSCode）
.vscode/

# 本地测试 ROM（不要提交版权游戏文件）
#emulator/roms/

# 本地个人数据 / AI 助手状态（claude、pi）
.claude/
.pi/state/
.pi/memory/work-log/

# Python 缓存
__pycache__/
Python/

# 打包产物
*.zip

# 本地调试脚本（含本机绝对路径 / 环境变量依赖）
ptcg/tools/analyze_dropped.py
ptcg/test-ai-save.mjs
