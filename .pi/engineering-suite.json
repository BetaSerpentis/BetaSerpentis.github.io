{
  "policy": {
    "workspaceOnly": true,
    "allowRead": ["**/*"],
    "allowWrite": ["**/*"],
    "denyRead": [".env", ".env.*", "**/*.pem", "**/*.key", ".git/**"],
    "denyWrite": [".git/**", "node_modules/**", "dist/**", "build/**"],
    "bash": {
      "mode": "allow",
      "allow": [
        "ls*",
        "dir*",
        "pwd",
        "cat*",
        "head*",
        "tail*",
        "wc*",
        "cut*",
        "sort*",
        "diff*",
        "awk*",
        "sed*",
        "od*",
        "echo*",
        "touch*",
        "mkdir*",
        "rmdir*",
        "Get-ChildItem*",
        "Get-Content*",
        "Select-String*",
        "rg*",
        "grep*",
        "find*",
        "file*",
        "node*",
        "python*",
        "git status*",
        "git diff*",
        "git log*",
        "git show*",
        "git add*",
        "git commit*",
        "git push*",
        "git pull*",
        "git fetch*",
        "git stash*",
        "git merge*",
        "git rebase*",
        "git reset*",
        "git checkout*",
        "git branch*",
        "svn status*",
        "svn diff*",
        "svn log*",
        "svn blame*",
        "npm test*",
        "npm run typecheck*",
        "pytest*",
        "python -m pytest*"
      ],
      "deny": ["sudo *", "rm -rf /*", "curl * | sh", "wget * | sh", "svn commit*", "svn ci*"]
    }
  }
}
